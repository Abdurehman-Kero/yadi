# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://yadi:yadi_dev_password@127.0.0.1:5433/yadi
LOG_LEVEL=INFO
# Used by the web app to reach the API (server-side rewrite)
API_INTERNAL_URL=http://127.0.0.1:8000
# Development-only sign-in stand-in (ADR-005). Must stay false/unset in production.
DEV_IDENTITY_ENABLED=true
# Optional. Without a key, Yadi works and "Tell Yadi" falls back to the manual form.
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_DAILY_CALL_LIMIT=200
